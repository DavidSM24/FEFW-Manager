<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/imperial_button_disabled" />
    <item>
        <ripple android:color="@color/bronze_ripple">
            <item>
                <shape>
                    <gradient android:angle="270" android:startColor="@color/imperial_crimson"
                        android:endColor="@color/crimson_shade" />
                    <stroke android:width="1dp" android:color="@color/imperial_gold" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
