<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="315" android:startColor="@color/imperial_blue"
                android:endColor="@color/panel_shadow" />
            <stroke android:width="1dp" android:color="@color/panel_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/panel_inlay" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
