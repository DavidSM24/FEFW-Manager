<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingTop="6dp"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="@dimen/section_gap">

        <Button
            android:id="@+id/back_to_routes"
            style="@style/Widget.FefwManager.Back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back_to_routes" />

        <LinearLayout
            android:id="@+id/page_header"
            style="@style/Widget.FefwManager.TitlePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include
                    android:id="@+id/route_portrait"
                    layout="@layout/view_unit_portrait"
                    android:layout_width="@dimen/title_emblem_size"
                    android:layout_height="@dimen/title_emblem_size"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/route_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Fefw.Title" />

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="12dp"
                        android:layout_marginTop="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/imperial_rule" />

                    <TextView
                        android:id="@+id/mission_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.Fefw.Body" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/mission_summary_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap"
                android:textAppearance="@style/TextAppearance.Fefw.Body"
                android:textColor="@color/parchment"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/manage_mission"
            style="@style/Widget.FefwManager.RouteAction.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:drawableStart="@drawable/ic_mission_seal"
            android:text="@string/edit_main_mission" />

        <Button
            android:id="@+id/manage_units"
            style="@style/Widget.FefwManager.RouteAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap"
            android:drawableStart="@drawable/ic_unit_standard"
            android:text="@string/manage_units" />

        <Button
            android:id="@+id/manage_supports"
            style="@style/Widget.FefwManager.RouteAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap"
            android:drawableStart="@drawable/ic_support_links"
            android:text="@string/manage_supports" />

    </LinearLayout>
</ScrollView>
