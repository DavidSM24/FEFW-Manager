<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/back_to_routes"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back_to_routes"
            android:textAllCaps="false"
            android:textColor="@color/sand" />

        <TextView
            android:id="@+id/route_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="serif"
            android:textColor="@color/parchment"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/mission_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/sand"
            android:textSize="16sp" />

        <Button
            android:id="@+id/manage_mission"
            style="@style/Widget.FefwManager.RouteAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/main_mission" />

        <Button
            android:id="@+id/manage_units"
            style="@style/Widget.FefwManager.RouteAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/manage_units" />

        <Button
            android:id="@+id/manage_supports"
            style="@style/Widget.FefwManager.RouteAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/manage_supports" />

    </LinearLayout>
</ScrollView>
