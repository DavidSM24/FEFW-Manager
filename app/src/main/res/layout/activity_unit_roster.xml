<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingTop="6dp"
    android:paddingEnd="@dimen/screen_gutter"
    android:paddingBottom="@dimen/section_gap">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/back_to_route"
            style="@style/Widget.FefwManager.Back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:layout_marginEnd="48dp"
            android:text="@string/back_to_route" />

        <ImageButton
            android:id="@+id/show_group_analysis"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/imperial_button_secondary"
            android:contentDescription="@string/group_analysis_title"
            android:enabled="false"
            android:scaleType="center"
            android:src="@drawable/ic_group_sword" />
    </FrameLayout>

    <include
        android:id="@+id/page_header"
        layout="@layout/view_ledger_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap" />

    <Button
        android:id="@+id/add_unit"
        style="@style/Widget.FefwManager.RouteAction.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_gap"
        android:drawableStart="@drawable/ic_ledger_add"
        android:text="@string/add_unit" />

    <TextView
        android:id="@+id/unit_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/imperial_ledger"
        android:padding="@dimen/panel_inset"
        android:textAppearance="@style/TextAppearance.Fefw.LedgerBody"
        android:visibility="gone" />

    <ListView
        android:id="@+id/recruited_unit_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/item_gap"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:visibility="gone" />
</LinearLayout>
