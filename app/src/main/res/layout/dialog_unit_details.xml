<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/panel_inset">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/detail_unit_portrait"
                layout="@layout/view_unit_portrait"
                android:layout_width="64dp"
                android:layout_height="64dp" />

            <TextView
                android:id="@+id/detail_unit_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/item_gap"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Fefw.DialogTitle"
                android:textColor="@color/imperial_gold" />
        </LinearLayout>

        <TextView
            android:id="@+id/detail_unit_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap"
            android:textAppearance="@style/TextAppearance.Fefw.Body" />

        <TextView
            android:id="@+id/detail_unit_class_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:textAppearance="@style/TextAppearance.Fefw.Inscription"
            android:textColor="@color/imperial_gold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.davidsm24.fefwmanager.units.HoldImageButton
                android:id="@+id/detail_unit_class_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/item_gap"
                android:background="@drawable/imperial_touch"
                android:contentDescription="@null"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/detail_unit_class_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Fefw.Body" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
