<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/route_row_background"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/route_initial"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/route_initial_background"
        android:fontFamily="serif"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textSize="24sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/route_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textColor="@color/parchment"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/route_deadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/sand"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
