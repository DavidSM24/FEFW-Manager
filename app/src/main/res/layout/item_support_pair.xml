<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/imperial_ledger"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <include
        android:id="@+id/first_member"
        layout="@layout/view_support_member"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/support_pair_connector"
        android:textColor="@color/ink_muted"
        android:textSize="18sp" />

    <include
        android:id="@+id/second_member"
        layout="@layout/view_support_member"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <Button
        android:id="@+id/remove_support"
        style="@style/Widget.FefwManager.LedgerAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/remove_unit" />
</LinearLayout>
