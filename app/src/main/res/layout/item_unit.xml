<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/imperial_ledger"
    android:foreground="@drawable/imperial_touch"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/unit_initial"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/route_initial_background"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.Fefw.Display"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/unit_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Fefw.LedgerBody"
        android:textSize="17sp" />

    <Button
        android:id="@+id/remove_unit"
        style="@style/Widget.FefwManager.LedgerAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/remove_unit" />
</LinearLayout>
