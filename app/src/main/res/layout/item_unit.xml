<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/imperial_ledger"
    android:foreground="@drawable/imperial_touch"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <include
        android:id="@+id/unit_portrait"
        layout="@layout/view_unit_portrait"
        android:layout_width="48dp"
        android:layout_height="48dp" />

    <TextView
        android:id="@+id/unit_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.Fefw.LedgerBody"
        android:textSize="17sp" />

    <com.davidsm24.fefwmanager.units.HoldImageButton
        android:id="@+id/recruited_class_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/imperial_touch"
        android:contentDescription="@null"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <Button
        android:id="@+id/assign_class"
        style="@style/Widget.FefwManager.LedgerAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/assign_class"
        android:textColor="@color/ink"
        android:visibility="gone" />

    <Button
        android:id="@+id/remove_unit"
        style="@style/Widget.FefwManager.LedgerAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/remove_unit" />
</LinearLayout>
