<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/imperial_ledger"
    android:foreground="@drawable/imperial_touch"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <com.davidsm24.fefwmanager.units.HoldImageButton
        android:id="@+id/class_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/imperial_touch"
        android:contentDescription="@null"
        android:focusable="false"
        android:padding="3dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/class_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:textAppearance="@style/TextAppearance.Fefw.LedgerBody"
        android:textSize="17sp" />
</LinearLayout>
