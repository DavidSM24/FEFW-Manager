<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.FefwManager.TitlePanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/group_analysis_title"
        android:textAppearance="@style/TextAppearance.Fefw.Inscription"
        android:textColor="@color/imperial_gold" />

    <TextView
        android:id="@+id/group_evaluated_units"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Fefw.Body" />

    <LinearLayout
        android:id="@+id/group_scores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/group_attack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Fefw.Body" />

        <TextView
            android:id="@+id/group_defense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Fefw.Body" />

        <TextView
            android:id="@+id/group_mobility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Fefw.Body" />

        <TextView
            android:id="@+id/group_support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Fefw.Body" />

        <TextView
            android:id="@+id/group_healing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Fefw.Body" />
    </LinearLayout>
</LinearLayout>
