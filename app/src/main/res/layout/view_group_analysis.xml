<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.FefwManager.TitlePanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/group_analysis_title"
        android:textAppearance="@style/TextAppearance.Fefw.Inscription"
        android:textColor="@color/imperial_gold" />

    <TextView
        android:id="@+id/group_evaluated_units"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Fefw.Body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap"
        android:orientation="vertical">

        <include
            android:id="@+id/group_attack"
            layout="@layout/view_group_metric" />

        <include
            android:id="@+id/group_defense"
            layout="@layout/view_group_metric" />

        <include
            android:id="@+id/group_mobility"
            layout="@layout/view_group_metric" />

        <include
            android:id="@+id/group_support"
            layout="@layout/view_group_metric" />

        <include
            android:id="@+id/group_healing"
            layout="@layout/view_group_metric" />
    </LinearLayout>

    <TextView
        android:id="@+id/group_alert_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap"
        android:text="@string/group_alerts_title"
        android:textAppearance="@style/TextAppearance.Fefw.Inscription"
        android:textColor="@color/imperial_gold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/group_alerts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Fefw.Body"
        android:visibility="gone" />

    <TextView
        android:id="@+id/group_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap"
        android:textAppearance="@style/TextAppearance.Fefw.Body"
        android:visibility="gone" />
</LinearLayout>
