<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:importantForAccessibility="yes"
    android:minHeight="28dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/metric_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.Fefw.Body" />

    <ProgressBar
        android:id="@+id/metric_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:max="5000"
        android:maxHeight="6dp"
        android:progressBackgroundTint="@color/panel_inlay" />

    <TextView
        android:id="@+id/metric_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.Fefw.Body"
        android:textColor="@color/parchment"
        android:textStyle="bold" />
</LinearLayout>
