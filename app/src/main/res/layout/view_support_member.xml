<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <include
        android:id="@+id/support_member_portrait"
        layout="@layout/view_unit_portrait"
        android:layout_width="48dp"
        android:layout_height="48dp" />

    <TextView
        android:id="@+id/support_member_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Fefw.LedgerBody" />

    <TextView
        android:id="@+id/support_member_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:text="@string/support_member_not_recruited"
        android:textColor="@color/ink_crimson"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
