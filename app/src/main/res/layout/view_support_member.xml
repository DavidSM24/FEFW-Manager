<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/support_member_initial"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/route_initial_background"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.Fefw.Display"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/support_member_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Fefw.LedgerBody" />

    <TextView
        android:id="@+id/support_member_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:text="@string/support_member_not_recruited"
        android:textColor="@color/ink_crimson"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
