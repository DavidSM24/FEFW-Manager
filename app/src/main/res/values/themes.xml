<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FefwManager" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/imperial_page</item>
        <item name="android:statusBarColor">@color/midnight_deep</item>
        <item name="android:navigationBarColor">@color/midnight_deep</item>
        <item name="android:colorAccent">@color/imperial_gold</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.Fefw.Dialog</item>
        <item name="android:windowAnimationStyle">@style/Animation.Fefw.Screen</item>
    </style>

    <style name="ThemeOverlay.Fefw.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/imperial_panel</item>
        <item name="android:windowAnimationStyle">@style/Animation.Fefw.Dialog</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="android:colorAccent">@color/imperial_gold</item>
        <item name="android:textColorPrimary">@color/parchment</item>
        <item name="android:textColorSecondary">@color/sand</item>
        <item name="android:textAppearanceLarge">@style/TextAppearance.Fefw.DialogTitle</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Widget.FefwManager.DialogConfirm</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Widget.FefwManager.DialogCancel</item>
    </style>

    <style name="Animation.Fefw.Screen" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/imperial_open</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/imperial_close</item>
    </style>
    <style name="Animation.Fefw.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/imperial_dialog_open</item>
        <item name="android:windowExitAnimation">@anim/imperial_dialog_close</item>
    </style>

    <style name="Widget.FefwManager.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/imperial_button_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/imperial_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Widget.FefwManager.RouteAction" parent="Widget.FefwManager.Button">
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">57dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:enabled">false</item>
    </style>
    <style name="Widget.FefwManager.RouteAction.Primary" parent="Widget.FefwManager.RouteAction">
        <item name="android:background">@drawable/imperial_button_primary</item>
    </style>
    <style name="Widget.FefwManager.DialogConfirm" parent="Widget.FefwManager.Button">
        <item name="android:background">@drawable/imperial_button_primary</item>
    </style>
    <style name="Widget.FefwManager.DialogCancel" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/sand</item>
    </style>
    <style name="Widget.FefwManager.Back" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:drawableStart">@drawable/ic_gate_back</item>
        <item name="android:drawablePadding">9dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/sand</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Widget.FefwManager.LedgerAction" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ink_crimson</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Widget.FefwManager.TitlePanel" parent="">
        <item name="android:background">@drawable/imperial_panel</item>
        <item name="android:padding">@dimen/panel_inset</item>
    </style>
    <style name="Widget.FefwManager.MissionField" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/imperial_field</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_muted</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
