<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FefwManager" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/midnight</item>
        <item name="android:colorAccent">@color/sand</item>
    </style>
    <style name="Widget.FefwManager.RouteAction" parent="@android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/route_surface</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/parchment</item>
        <item name="android:textSize">16sp</item>
        <item name="android:enabled">false</item>
    </style>
</resources>
